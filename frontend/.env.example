# WARNING: All VITE_ variables are compiled into the client bundle and visible to end users.
# NEVER put secrets, API keys, or tokens here.
VITE_API_URL=http://localhost:3000
VITE_SENTRY_DSN=           # Optional: Sentry DSN for frontend error tracking
SENTRY_AUTH_TOKEN=         # For source map uploads at build time
SENTRY_ORG=                # Sentry organization slug
SENTRY_PROJECT=            # Sentry project slug
